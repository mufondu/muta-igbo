{
  // Cloudflare Workers static-assets deploy for the Expo web build (output in ./dist).
  "name": "muta-igbo",
  "compatibility_date": "2026-06-28",
  "assets": {
    "directory": "./dist",
    // Single-page app: unknown paths (e.g. a refresh on a deep link) serve index.html.
    "not_found_handling": "single-page-application"
  }
}
